prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3DUtils
Description: Qt Quick3DUtils module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3DUtils
Cflags: -I${includedir}/QtQuick3DUtils -I${includedir} -DQT_QUICK3DUTILS_LIB
