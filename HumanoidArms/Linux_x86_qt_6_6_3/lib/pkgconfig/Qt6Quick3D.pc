prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3D
Description: Qt Quick3D module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3D
Cflags: -I${includedir}/QtQuick3D -I${includedir} -DQT_QUICK3D_LIB
