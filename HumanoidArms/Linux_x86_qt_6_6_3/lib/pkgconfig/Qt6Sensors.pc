prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Sensors
Description: Qt Sensors module
Version: 6.6.3
Libs: -L${libdir} -lQt6Sensors
Cflags: -I${includedir}/QtSensors -I${includedir} -DQT_SENSORS_LIB
