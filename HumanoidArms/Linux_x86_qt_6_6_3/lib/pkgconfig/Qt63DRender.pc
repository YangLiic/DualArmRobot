prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DRender
Description: Qt 3DRender module
Version: 6.6.3
Libs: -L${libdir} -lQt63DRender
Cflags: -I${includedir}/Qt3DRender -I${includedir} -DQT_3DRENDER_LIB
