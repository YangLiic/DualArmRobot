prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3DParticles
Description: Qt Quick3DParticles module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3DParticles
Cflags: -I${includedir}/QtQuick3DParticles -I${includedir} -DQT_QUICK3DPARTICLES_LIB
