prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 VirtualKeyboard
Description: Qt VirtualKeyboard module
Version: 6.6.3
Libs: -L${libdir} -lQt6VirtualKeyboard
Cflags: -I${includedir}/QtVirtualKeyboard -I${includedir} -DQT_VIRTUALKEYBOARD_LIB
