prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3DAssetUtils
Description: Qt Quick3DAssetUtils module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3DAssetUtils
