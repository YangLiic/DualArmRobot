prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DQuickInput
Description: Qt 3DQuickInput module
Version: 6.6.3
Libs: -L${libdir} -lQt63DQuickInput
Cflags: -I${includedir}/Qt3DQuickInput -I${includedir} -DQT_3DQUICKINPUT_LIB
