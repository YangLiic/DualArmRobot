prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 UiTools
Description: Qt UiTools module
Version: 6.6.3
Libs: -L${libdir} -lQt6UiTools
Cflags: -I${includedir}/QtUiTools -I${includedir} -DQT_UITOOLS_LIB
