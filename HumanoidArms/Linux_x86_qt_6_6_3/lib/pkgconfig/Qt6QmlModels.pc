prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 QmlModels
Description: Qt QmlModels module
Version: 6.6.3
Libs: -L${libdir} -lQt6QmlModels
Cflags: -I${includedir}/QtQmlModels -I${includedir} -DQT_QMLMODELS_LIB
