prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 WebView
Description: Qt WebView module
Version: 6.6.3
Libs: -L${libdir} -lQt6WebView
Cflags: -I${includedir}/QtWebView -I${includedir} -DQT_WEBVIEW_LIB
