prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 SerialBus
Description: Qt SerialBus module
Version: 6.6.3
Libs: -L${libdir} -lQt6SerialBus
Cflags: -I${includedir}/QtSerialBus -I${includedir} -DQT_SERIALBUS_LIB
