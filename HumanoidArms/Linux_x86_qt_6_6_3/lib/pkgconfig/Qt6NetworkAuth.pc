prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 NetworkAuth
Description: Qt NetworkAuth module
Version: 6.6.3
Libs: -L${libdir} -lQt6NetworkAuth
Cflags: -I${includedir}/QtNetworkAuth -I${includedir} -DQT_NETWORKAUTH_LIB
