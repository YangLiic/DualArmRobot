prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 WebSockets
Description: Qt WebSockets module
Version: 6.6.3
Libs: -L${libdir} -lQt6WebSockets
Cflags: -I${includedir}/QtWebSockets -I${includedir} -DQT_WEBSOCKETS_LIB
