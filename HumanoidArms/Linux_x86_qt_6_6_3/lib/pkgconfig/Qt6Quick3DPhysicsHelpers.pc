prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3DPhysicsHelpers
Description: Qt Quick3DPhysicsHelpers module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3DPhysicsHelpers
Cflags: -I${includedir}/QtQuick3DPhysicsHelpers -I${includedir} -DQT_QUICK3DPHYSICSHELPERS_LIB
