prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DQuickExtras
Description: Qt 3DQuickExtras module
Version: 6.6.3
Libs: -L${libdir} -lQt63DQuickExtras
Cflags: -I${includedir}/Qt3DQuickExtras -I${includedir} -DQT_3DQUICKEXTRAS_LIB
