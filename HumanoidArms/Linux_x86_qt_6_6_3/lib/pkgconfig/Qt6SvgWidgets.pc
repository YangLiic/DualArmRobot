prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 SvgWidgets
Description: Qt SvgWidgets module
Version: 6.6.3
Libs: -L${libdir} -lQt6SvgWidgets
Cflags: -I${includedir}/QtSvgWidgets -I${includedir} -DQT_SVGWIDGETS_LIB
