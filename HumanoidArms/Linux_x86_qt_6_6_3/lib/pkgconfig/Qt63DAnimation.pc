prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DAnimation
Description: Qt 3DAnimation module
Version: 6.6.3
Libs: -L${libdir} -lQt63DAnimation
Cflags: -I${includedir}/Qt3DAnimation -I${includedir} -DQT_3DANIMATION_LIB
