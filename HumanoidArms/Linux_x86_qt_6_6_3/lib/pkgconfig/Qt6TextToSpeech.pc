prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 TextToSpeech
Description: Qt TextToSpeech module
Version: 6.6.3
Libs: -L${libdir} -lQt6TextToSpeech
Cflags: -I${includedir}/QtTextToSpeech -I${includedir} -DQT_TEXTTOSPEECH_LIB
