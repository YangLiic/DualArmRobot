prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DQuickRender
Description: Qt 3DQuickRender module
Version: 6.6.3
Libs: -L${libdir} -lQt63DQuickRender
Cflags: -I${includedir}/Qt3DQuickRender -I${includedir} -DQT_3DQUICKRENDER_LIB
