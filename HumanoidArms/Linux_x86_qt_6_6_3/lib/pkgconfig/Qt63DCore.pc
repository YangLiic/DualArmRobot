prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 3DCore
Description: Qt 3DCore module
Version: 6.6.3
Libs: -L${libdir} -lQt63DCore
Cflags: -I${includedir}/Qt3DCore -I${includedir} -DQT_3DCORE_LIB
