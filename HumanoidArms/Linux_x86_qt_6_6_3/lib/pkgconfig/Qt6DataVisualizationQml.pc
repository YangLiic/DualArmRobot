prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 DataVisualizationQml
Description: Qt DataVisualizationQml module
Version: 6.6.3
Libs: -L${libdir} -lQt6DataVisualizationQml
Cflags: -I${includedir}/QtDataVisualizationQml -I${includedir} -DQT_DATAVISUALIZATIONQML_LIB
