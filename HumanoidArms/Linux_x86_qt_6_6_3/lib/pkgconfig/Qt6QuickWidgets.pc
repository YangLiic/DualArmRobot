prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 QuickWidgets
Description: Qt QuickWidgets module
Version: 6.6.3
Libs: -L${libdir} -lQt6QuickWidgets
Cflags: -I${includedir}/QtQuickWidgets -I${includedir} -DQT_QUICKWIDGETS_LIB
