prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Bluetooth
Description: Qt Bluetooth module
Version: 6.6.3
Libs: -L${libdir} -lQt6Bluetooth
Cflags: -I${includedir}/QtBluetooth -I${includedir} -DQT_BLUETOOTH_LIB
