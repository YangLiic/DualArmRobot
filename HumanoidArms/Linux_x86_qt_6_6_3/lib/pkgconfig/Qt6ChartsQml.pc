prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 ChartsQml
Description: Qt ChartsQml module
Version: 6.6.3
Libs: -L${libdir} -lQt6ChartsQml
Cflags: -I${includedir}/QtChartsQml -I${includedir} -DQT_CHARTSQML_LIB
