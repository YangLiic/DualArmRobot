prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 QuickTimeline
Description: Qt QuickTimeline module
Version: 6.6.3
Libs: -L${libdir} -lQt6QuickTimeline
Cflags: -I${includedir}/QtQuickTimeline -I${includedir} -DQT_QUICKTIMELINE_LIB
