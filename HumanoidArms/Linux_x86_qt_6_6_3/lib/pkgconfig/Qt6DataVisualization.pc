prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 DataVisualization
Description: Qt DataVisualization module
Version: 6.6.3
Libs: -L${libdir} -lQt6DataVisualization
Cflags: -I${includedir}/QtDataVisualization -I${includedir} -DQT_DATAVISUALIZATION_LIB
