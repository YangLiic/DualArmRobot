prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 ScxmlQml
Description: Qt ScxmlQml module
Version: 6.6.3
Libs: -L${libdir} -lQt6ScxmlQml
Cflags: -I${includedir}/QtScxmlQml -I${includedir} -DQT_SCXMLQML_LIB
