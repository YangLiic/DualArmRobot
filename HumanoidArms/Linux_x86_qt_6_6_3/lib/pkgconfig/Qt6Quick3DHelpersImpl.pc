prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 Quick3DHelpersImpl
Description: Qt Quick3DHelpersImpl module
Version: 6.6.3
Libs: -L${libdir} -lQt6Quick3DHelpersImpl
Cflags: -I${includedir}/QtQuick3DHelpersImpl -I${includedir} -DQT_QUICK3DHELPERSIMPL_LIB
