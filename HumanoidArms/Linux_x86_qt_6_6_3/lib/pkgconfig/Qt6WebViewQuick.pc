prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 WebViewQuick
Description: Qt WebViewQuick module
Version: 6.6.3
Libs: -L${libdir} -lQt6WebViewQuick
Cflags: -I${includedir}/QtWebViewQuick -I${includedir} -DQT_WEBVIEWQUICK_LIB
