prefix=/opt/qt6.6.3
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/./libexec
libdir=${prefix}/lib
includedir=${prefix}/include

Name: Qt6 DeclarativeOpcua
Description: Qt DeclarativeOpcua module
Version: 6.6.3
Libs: -L${libdir} -lQt6DeclarativeOpcua
Cflags: -I${includedir}/QtDeclarativeOpcua -I${includedir} -DQT_DECLARATIVEOPCUA_LIB
