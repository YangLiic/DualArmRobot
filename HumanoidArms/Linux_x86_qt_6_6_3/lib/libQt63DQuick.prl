QMAKE_PRL_TARGET = libQt63DQuick.so
QMAKE_PRL_CONFIG = shared
QMAKE_PRL_VERSION = 6.6.3
QMAKE_PRL_LIBS = -lxkbcommon $$[QT_INSTALL_LIBS]/libQt63DCore.so $$[QT_INSTALL_LIBS]/libQt6Concurrent.so $$[QT_INSTALL_LIBS]/libQt6Quick.so $$[QT_INSTALL_LIBS]/libQt6QmlModels.so $$[QT_INSTALL_LIBS]/libQt6OpenGL.so $$[QT_INSTALL_LIBS]/libQt6Gui.so -lGLX -lOpenGL $$[QT_INSTALL_LIBS]/libQt6Qml.so $$[QT_INSTALL_LIBS]/libQt6Network.so $$[QT_INSTALL_LIBS]/libQt6Core.so
QMAKE_PRL_LIBS_FOR_CMAKE = -lxkbcommon;$$[QT_INSTALL_LIBS]/libQt63DCore.so;$$[QT_INSTALL_LIBS]/libQt6Concurrent.so;$$[QT_INSTALL_LIBS]/libQt6Quick.so;$$[QT_INSTALL_LIBS]/libQt6QmlModels.so;$$[QT_INSTALL_LIBS]/libQt6OpenGL.so;$$[QT_INSTALL_LIBS]/libQt6Gui.so;-lGLX;-lOpenGL;$$[QT_INSTALL_LIBS]/libQt6Qml.so;$$[QT_INSTALL_LIBS]/libQt6Network.so;$$[QT_INSTALL_LIBS]/libQt6Core.so
